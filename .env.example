APP_NAME="Saf ERP"
APP_VERSION=dev
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://Saf_Erp.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Optional: full paths when mysqldump/mysql are not on PATH (common on Windows)
# MYSQL_DUMP_PATH="C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe"
# MYSQL_CLIENT_PATH="C:\Program Files\MySQL\MySQL Server 8.4\bin\mysql.exe"

# Automatic database backups (requires cron: * * * * * php artisan schedule:run)
DB_BACKUP_SCHEDULE_ENABLED=true
DB_BACKUP_SCHEDULE=daily
DB_BACKUP_SCHEDULE_TIME=02:00
DB_BACKUP_SCHEDULE_DAY=0
DB_BACKUP_RETENTION_DAYS=14

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Sales demo seed (migrate:fresh --seed)
SEED_SALES_DEMO=true
SEED_DEMO_YEARS=1
SEED_DEMO_SCALE=large
# SEED_LEGACY_CATALOG=true
# LEGACY_IMPORT_DATABASE=saferp_legacy_import
# Place SQL dump at storage/app/imports/legacy-catalog.sql
